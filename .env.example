#Ollama exposes an OpenAI-compatible endpoint,
#so use the OpenAI provider package pointed at localhost.
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=ollama
MODEL=llama3.2

# Retrieval over the repo's own markdown docs.
# nomic-embed-text is 768-dimensional; changing the model means changing
# EMBEDDING_DIM and re-indexing, because stored vectors are not comparable
# across models.
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768

# Postgres from docker-compose.yml at the repo root.
DATABASE_URL=postgresql://workbench:workbench@localhost:5433/workbench
