            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "FastAPI",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/agent": {
      "post": {
        "description": "Start a run and return its id. Does not wait for it to finish.\n\n`202`, not `200`: the answer does not exist yet, and for a run that needs\nan action approved it cannot exist until a person has decided. Poll\n`GET /agent/{run_id}` - with `?wait=` to be told rather than to ask.",
        "operationId": "start_agent_run_agent_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AgentRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunView"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Start Agent Run"
      }
    },
    "/agent/runs": {
      "get": {
        "description": "Every live run, newest first. Filter on `status` for the approval queue.",
        "operationId": "list_agent_runs_agent_runs_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/RunView"
                  },
                  "title": "Response List Agent Runs Agent Runs Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Agent Runs"
      }
    },
    "/agent/{run_id}": {
      "get": {
        "description": "The run as it stands.\n\n`wait` blocks while the run is busy and returns the moment it wants\nsomething - an approval - or has finished. The same call therefore serves\n\"tell me when there is something to decide\" and \"tell me when it is done\",\nwhich is the difference between a front end that reacts and one that\npolls. It is capped so a caller cannot hold a thread indefinitely.",
        "operationId": "get_agent_run_agent__run_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "run_id",
            "required": true,
            "schema": {
              "title": "Run Id",
              "type": "string"
            }
          },
          {
            "description": "Seconds to block until the run needs the caller again.",
            "in": "query",
            "name": "wait",
            "required": false,
            "schema": {
              "default": 0.0,
              "description": "Seconds to block until the run needs the caller again.",
              "maximum": 25.0,
              "minimum": 0.0,
              "title": "Wait",
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunView"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Agent Run"
      }
    },
    "/agent/{run_id}/decision": {
      "post": {
        "description": "Approve or reject the action a run is waiting on, and release it.\n\nA rejection is an ordinary outcome, not an error: the model is told the\naction was refused and why, and carries on. A `409` means there was nothing\nto decide - the run is not waiting, it was decided already, or nobody\nanswered in time and it has expired.",
        "operationId": "decide_agent_run_agent__run_id__decision_post",
        "parameters": [
          {
            "in": "path",
            "name": "run_id",
            "required": true,
            "schema": {
              "title": "Run Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DecisionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunView"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Decide Agent Run"
      }
    },
    "/ask": {
      "post": {
        "description": "Answer from the indexed documentation. Not streamed: the sources are\npart of the result and are only known once retrieval has finished.\n\nReads the index per request, so `python index_docs.py` takes effect on the\nnext question with no restart.",
        "operationId": "ask_ask_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AskRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AskResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Ask"
      }
    },
    "/chat": {
      "post": {
        "operationId": "chat_chat_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Chat"
      }
    },
    "/classify": {
      "post": {
        "description": "Classify one support ticket. Whole object or an error \u2014 never partial.\n\nNot streamed: the caller wants a complete result, and a half-received\nobject cannot be validated against the schema.",
        "operationId": "classify_ticket_classify_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ClassifyRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClassificationResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
